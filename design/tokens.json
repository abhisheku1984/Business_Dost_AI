{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Business Dost AI",
    "version": "1.0.0",
    "status": "review",
    "canvas": { "width": 390, "height": 844, "unit": "pt" },
    "themes": ["light", "dark"],
    "source": "design/css/tokens.css",
    "note": "Semantic names are the contract. Components consume these roles, never raw hex values. The dark theme swaps the map, not the markup."
  },

  "color": {
    "brand": {
      "base": { "light": "#0a6a56", "dark": "#3ed3ad" },
      "hover": { "light": "#085444", "dark": "#61e2c2" },
      "pressed": { "light": "#064334", "dark": "#2bbd99" },
      "text": { "light": "#0a6a56", "dark": "#4bdcb6" },
      "soft": { "light": "#e6f3ef", "dark": "rgba(62,211,173,0.13)" },
      "softAlt": { "light": "#f1f9f6", "dark": "rgba(62,211,173,0.07)" },
      "onBrand": { "light": "#ffffff", "dark": "#042019" },
      "focusRing": { "light": "rgba(10,106,86,0.32)", "dark": "rgba(62,211,173,0.36)" }
    },

    "ai": {
      "description": "The only place blue and violet appear. Reserved for AI moments: the orb, AI badges, the assistant avatar and the mark's dot.",
      "stops": ["#35d6a9", "#54b4f2", "#9c8df2"],
      "gradient": "linear-gradient(135deg, #35d6a9 0%, #54b4f2 52%, #9c8df2 100%)",
      "gradientDark": "linear-gradient(135deg, #3ee0b2 0%, #5fbcf7 52%, #ab9cf7 100%)",
      "gradientSoft": "linear-gradient(135deg, rgba(53,214,169,0.16), rgba(84,180,242,0.14) 52%, rgba(156,141,242,0.16))"
    },

    "surface": {
      "bg": { "light": "#f4f4f6", "dark": "#08080a" },
      "bg2": { "light": "#ededf0", "dark": "#0d0d10" },
      "card": { "light": "#ffffff", "dark": "#121216" },
      "card2": { "light": "#fafafb", "dark": "#16161b" },
      "card3": { "light": "#f3f3f5", "dark": "#1d1d23" },
      "inverse": { "light": "#0c0c0f", "dark": "#ffffff" }
    },

    "ink": {
      "primary": { "light": "#0b0b0e", "dark": "#f4f5f7" },
      "secondary": { "light": "#43484f", "dark": "#b9bec6" },
      "tertiary": { "light": "#6b7078", "dark": "#8d939b" },
      "quaternary": { "light": "#9ba0a7", "dark": "#6a7078" }
    },

    "line": {
      "hairline": { "light": "rgba(11,11,14,0.08)", "dark": "rgba(255,255,255,0.08)" },
      "strong": { "light": "rgba(11,11,14,0.14)", "dark": "rgba(255,255,255,0.15)" }
    },

    "status": {
      "success": { "light": "#0e7a5f", "dark": "#4bdcb6" },
      "successSoft": { "light": "#e6f3ef", "dark": "rgba(62,211,173,0.12)" },
      "warning": { "light": "#a86400", "dark": "#f0b45c" },
      "warningSoft": { "light": "#fcf1df", "dark": "rgba(240,180,92,0.12)" },
      "danger": { "light": "#c0362a", "dark": "#ff6f62" },
      "dangerSoft": { "light": "#fcecea", "dark": "rgba(255,111,98,0.12)" },
      "info": { "light": "#2c6fb5", "dark": "#7db9f0" },
      "infoSoft": { "light": "#e9f2fb", "dark": "rgba(125,185,240,0.12)" }
    },

    "chart": {
      "series": {
        "light": ["#0a6a56", "#4c9be0", "#8c7bee", "#e2a544", "#d9738e"],
        "dark": ["#3ed3ad", "#64b5f6", "#a99bf7", "#f0b45c", "#ec8fa5"]
      },
      "grid": { "light": "rgba(11,11,14,0.07)", "dark": "rgba(255,255,255,0.08)" },
      "track": { "light": "rgba(11,11,14,0.06)", "dark": "rgba(255,255,255,0.09)" }
    }
  },

  "typography": {
    "families": {
      "ui": "\"BD Inter\", \"BD Devanagari\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "numeric": "\"BD Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "numericFeature": "tabular-nums",
    "scale": {
      "display": { "size": 34, "line": 38, "weight": 700, "tracking": "-0.035em" },
      "title1": { "size": 28, "line": 32, "weight": 700, "tracking": "-0.03em" },
      "title2": { "size": 22, "line": 28, "weight": 650, "tracking": "-0.02em" },
      "headline": { "size": 17, "line": 24, "weight": 600, "tracking": "-0.012em" },
      "body": { "size": 15, "line": 22, "weight": 450, "tracking": "-0.006em" },
      "subhead": { "size": 13, "line": 18, "weight": 500, "tracking": "-0.002em" },
      "caption": { "size": 11, "line": 14, "weight": 550, "tracking": "0.012em" },
      "eyebrow": { "size": 10, "line": 13, "weight": 650, "tracking": "0.1em", "transform": "uppercase" }
    },
    "rules": [
      "Money, quantities and percentages always use tabular numerals.",
      "A screen has one display or title1 — never two competing headlines.",
      "Devanagari falls back automatically through the unicode-range split, so Hindi keeps the same rhythm."
    ]
  },

  "spacing": {
    "base": 4,
    "scale": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64, "11": 80, "12": 96 },
    "screen": { "gutter": 20, "section": 24, "cardPadding": 14, "rowHeight": 52 }
  },

  "radius": {
    "2xs": 6, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "2xl": 28, "3xl": 34, "sheet": 38, "full": 999,
    "usage": {
      "input": "sm (12)",
      "button": "md (16)",
      "card": "lg (20)",
      "heroCard": "xl (24)",
      "sheet": "sheet (38)",
      "device": "54 (frame only, never used in product UI)"
    }
  },

  "elevation": {
    "xs": { "light": "0 1px 2px rgba(11,11,14,0.04)", "dark": "0 1px 2px rgba(0,0,0,0.4)" },
    "sm": { "light": "0 1px 3px rgba(11,11,14,0.05), 0 1px 2px rgba(11,11,14,0.03)", "dark": "0 1px 3px rgba(0,0,0,0.45)" },
    "md": { "light": "0 8px 24px -10px rgba(11,11,14,0.14), 0 2px 6px rgba(11,11,14,0.04)", "dark": "0 10px 28px -12px rgba(0,0,0,0.7), 0 2px 6px rgba(0,0,0,0.35)" },
    "lg": { "light": "0 24px 56px -22px rgba(11,11,14,0.24), 0 4px 12px rgba(11,11,14,0.05)", "dark": "0 28px 64px -26px rgba(0,0,0,0.85), 0 4px 12px rgba(0,0,0,0.4)" },
    "orb": { "light": "0 18px 44px -14px rgba(10,106,86,0.55)", "dark": "0 20px 50px -14px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.06)" }
  },

  "motion": {
    "duration": { "instant": 100, "fast": 160, "base": 240, "slow": 320, "slower": 480 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.7, 0.3, 1)",
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "patterns": {
      "screenPush": "320ms entrance · translateX(18px) + fade",
      "sheet": "320ms entrance · translateY(100%) → 0, scrim 240ms",
      "press": "scale(0.97) at 100ms, release at 160ms",
      "orb": "3.2s breathing loop; rings 4.6s / 5.8s; waveform 1.1s per bar",
      "countUp": "480ms · tabular numerals, no layout shift"
    },
    "constraints": [
      "Transform and opacity only — no animated box-shadow or filter on scroll.",
      "Ambient loops pause when the screen is not visible and stop under prefers-reduced-motion.",
      "Haptics on approve, reject and the mic tap; no haptics on navigation."
    ]
  },

  "layout": {
    "canvas": { "width": 390, "height": 844 },
    "safeArea": { "top": 54, "bottom": 34 },
    "tabBar": { "height": 82, "slots": 5, "orbSize": 58, "orbLift": 22 },
    "grid": { "columns": 4, "gutter": 20, "cardGap": 12 },
    "contentMaxWidth": 640
  },

  "iconography": {
    "style": "1.6px stroke, round caps and joins, 24px grid, 20px default render",
    "sizes": { "sm": 16, "md": 20, "lg": 24, "xl": 28 },
    "strokeWidth": 1.6,
    "library": "60 symbols inlined in design/index.html",
    "rules": ["Icons never carry colour alone — pair with a label or a pill.", "Filled icons are reserved for active tab states and the AI glyph."]
  },

  "accessibility": {
    "contrast": {
      "bodyText": "≥ 4.5:1 in both themes (ink on bg 19.65 light / 17.13 dark)",
      "largeText": "≥ 3:1",
      "uiBoundaries": "≥ 3:1 for interactive outlines and fills that carry meaning"
    },
    "touchTarget": 44,
    "focusRing": "2px brand outline, 3px offset, never removed",
    "motion": "prefers-reduced-motion disables ambient loops and shortens transitions to 0.01ms",
    "labels": "Every icon-only control has an aria-label; live regions announce transcript, listening and approval states."
  }
}
